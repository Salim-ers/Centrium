{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-opus-4-7",
  "permissions": {
    "allow": [
      "Read(**)",
      "Write(src/**)",
      "Write(supabase/**)",
      "Write(tests/**)",
      "Write(public/**)",
      "Edit(**)",
      "Bash(npm run *)",
      "Bash(npx supabase *)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout -b *)",
      "Bash(git push*)",
      "Bash(node *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(npx tsx *)",
      "mcp__supabase__list_projects",
      "Read(//c/Users/Salim/Desktop/quadcore-platform/**)",
      "Read(//c/Users/Salim/**)",
      "Read(//c/Users/Salim/.claude/**)",
      "Read(//c/Users/Salim/.claude/projects/c--Users-Salim-Desktop-quadcore-platform/**)",
      "Bash(npm uninstall *)",
      "Bash(git commit -m 'chore: allow prod domain as Server Actions origin *)",
      "Bash(git commit -m 'chore\\(build\\): exclude vitest config and scripts from Next.js typecheck *)",
      "Bash(git commit -m 'fix\\(build\\): wrap useSearchParams in Suspense for billing and cv-optimizer *)",
      "Bash(git commit -m 'fix\\(cv-import\\): surface insert errors and normalize experience dates *)"
    ],
    "deny": [
      "Write(.env*)",
      "Write(**/*.key)",
      "Write(**/*.pem)",
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Bash(curl *sudo*)"
    ],
    "additionalDirectories": [
      "C:\\Users\\Salim\\Desktop\\quadcore-platform\\.next"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "command": ".claude/hooks/validate-bash.sh"
      }
    ]
  },
  "env": {
    "NODE_ENV": "development"
  }
}
