{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-opus-4-7",
  "permissions": {
    "allow": [
      "Read(**)",
      "Write(src/**)",
      "Write(supabase/**)",
      "Write(tests/**)",
      "Write(public/**)",
      "Edit(**)",
      "Bash(npm run *)",
      "Bash(npx supabase *)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout -b *)",
      "Bash(git push*)",
      "Bash(node *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(find *)",
      "Bash(grep *)"
    ],
    "deny": [
      "Write(.env*)",
      "Write(**/*.key)",
      "Write(**/*.pem)",
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Bash(curl *sudo*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "command": ".claude/hooks/validate-bash.sh"
      }
    ]
  },
  "env": {
    "NODE_ENV": "development"
  }
}
