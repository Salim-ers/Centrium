# =========================================================================
# QuadCore Platform - Variables d'environnement
# Copier ce fichier en .env.local et renseigner vos valeurs
# =========================================================================

# ---- Supabase (côté browser, publiques) ----
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ---- Supabase (côté serveur uniquement) ----
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---- App ----
# OBLIGATOIRE en production. Utilisée pour construire les URLs redirectTo
# des emails d'invitation Supabase Auth (consultant portal, team invite,
# magic links). Doit EXACTEMENT matcher une URL listée dans :
#   Supabase Dashboard → Auth → URL Configuration → Additional Redirect URLs.
# Si non définie sur Vercel, les emails d'invitation pointeront vers le host
# *.vercel.app du déploiement (différent à chaque preview), Supabase Auth
# refusera → "Error sending invite email".
# Dev : http://localhost:3000 — Prod : https://centrium-platform.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Centrium by QuadCore"

# ---- Super-console (fondateurs) ----
# Allowlist des emails autorisés à accéder à la super-console /admin,
# EN PLUS du rôle super_admin en DB (défense en profondeur — cf.
# src/lib/auth/super-admin.ts). Séparés par des virgules, 3-4 comptes max.
# Fortement recommandé en production. Si absent : seul le rôle DB compte.
FOUNDER_EMAILS=fondateur1@exemple.com,fondateur2@exemple.com

# ---- IA (Claude API) ----
# Extraction CV (upload consultant → profil rempli automatiquement)
# Obtenir une clé : https://console.anthropic.com/settings/keys
# Sans cette clé, l'extraction CV passe en mode heuristique (moins précis)
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=

# ---- Stripe (billing SaaS) ----
# Dashboard : https://dashboard.stripe.com/test/apikeys
#
# Secret key (côté serveur uniquement) : commence par sk_test_ / sk_live_
STRIPE_SECRET_KEY=sk_test_...
#
# Publishable key (côté client) : commence par pk_test_ / pk_live_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
#
# Webhook signing secret : obtenu via `stripe listen --forward-to ...` en dev,
# ou depuis Stripe Dashboard → Webhooks en prod. Format : whsec_...
STRIPE_WEBHOOK_SECRET=whsec_...
#
# ---- Stripe Price IDs (par plan) ----
# Source de vérité pour le code — lus par requireStripePriceId() dans
# src/lib/billing/config.ts, avec validation de format (^price_[a-zA-Z0-9]{16,}$).
#
# GÉNÉRATION AUTO : lance `npx tsx scripts/setup-stripe.ts` — le script crée
# les produits + prix côté Stripe, insère les Price IDs dans plans.stripe_price_id
# côté DB, puis affiche les 3 lignes ci-dessous prêtes à copier.
#
# GÉNÉRATION MANUELLE : Stripe Dashboard → Products → Add product → Add price
# récurrent mensuel EUR. Copie le Price ID (format `price_1ABC...`) ici.
STRIPE_STARTER_PRICE_ID=price_...      # Starter  — 74,99 € HT / mois
STRIPE_MEDIUM_PRICE_ID=price_...       # Medium   — 149,99 € HT / mois
STRIPE_ENTERPRISE_PRICE_ID=price_...   # Illimité — 299,99 € HT / mois

# ---- Resend (emails transactionnels) ----
# Dashboard : https://resend.com/api-keys
# Domaine vérifié : centrium-platform.com (DKIM + SPF + DMARC)
# Utilisée par :
#   - src/lib/security/device-tracking.ts (notif nouveau device)
#   - src/app/api/admin/purge-archives/route.ts (notif purge archives)
# Sans cette clé, ces deux flux loggent au lieu d'envoyer (dégradé silencieux).
RESEND_API_KEY=re_...

# ---- Claude Code MCP ----
SUPABASE_ACCESS_TOKEN=
GITHUB_TOKEN=
