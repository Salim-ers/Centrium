# =========================================================================
# QuadCore Platform - Variables d'environnement
# Copier ce fichier en .env.local et renseigner vos valeurs
# =========================================================================

# ---- Supabase (côté browser, publiques) ----
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ---- Supabase (côté serveur uniquement) ----
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---- App ----
# Dev : http://localhost:3000 — Prod : https://centrium-platform.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Centrium by QuadCore"

# ---- IA (Claude API) ----
# Extraction CV (upload consultant → profil rempli automatiquement)
# Obtenir une clé : https://console.anthropic.com/settings/keys
# Sans cette clé, l'extraction CV passe en mode heuristique (moins précis)
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=

# ---- Stripe (billing SaaS) ----
# Dashboard : https://dashboard.stripe.com/test/apikeys
# Secret (côté serveur uniquement) : commence par sk_test_ / sk_live_
STRIPE_SECRET_KEY=sk_test_...
# Publishable (côté client) : commence par pk_test_ / pk_live_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Webhook signing secret : obtenu via `stripe listen --forward-to ...` en dev
STRIPE_WEBHOOK_SECRET=whsec_...

# ---- Claude Code MCP ----
SUPABASE_ACCESS_TOKEN=
GITHUB_TOKEN=
