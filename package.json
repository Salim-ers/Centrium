{
  "name": "quadcore-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "node -e \"require('fs').copyFileSync('node_modules/pdfjs-dist/build/pdf.worker.min.mjs','public/pdf.worker.min.mjs')\"",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:reset": "npx supabase db reset",
    "db:types": "npx supabase gen types typescript --local > src/types/database.ts",
    "db:seed": "psql postgresql://postgres:postgres@localhost:54322/postgres -f supabase/seed/seed.sql",
    "docs:pdf": "node scripts/build-docs-pdf.mjs"
  },
